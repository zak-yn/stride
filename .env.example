PORT=3000
NODE_ENV=production

# Gemini 3.5 Flash Lite API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_KEY=your_fallback_gemini_api_key_here

# Upstash Redis Cloud REST API (Optional: local file persistence used if not provided)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXXX=
